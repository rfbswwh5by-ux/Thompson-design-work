{
  "name": "Inquiry",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Customer"
    },
    "full_name": {
      "type": "string",
      "title": "Full name"
    },
    "business_name": {
      "type": "string",
      "title": "Business name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "website_type": {
      "type": "string",
      "title": "Type of website needed"
    },
    "project_description": {
      "type": "string",
      "title": "Project description"
    },
    "budget": {
      "type": "string",
      "title": "Estimated budget"
    },
    "additional_info": {
      "type": "string",
      "title": "Additional information"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "New",
        "Contacted",
        "In Discussion",
        "Proposal Sent",
        "Won",
        "Lost"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "pink",
        "green",
        "red"
      ],
      "default": "New"
    },
    "is_read": {
      "type": "boolean",
      "title": "Read",
      "default": false
    },
    "source": {
      "type": "string",
      "title": "Source",
      "default": "Website contact form"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted at"
    }
  },
  "required": [
    "full_name",
    "email",
    "project_description"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}