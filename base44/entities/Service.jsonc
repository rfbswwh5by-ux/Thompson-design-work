{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Service name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "summary": {
      "type": "string",
      "title": "Short summary"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Benefits"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "icon": {
      "type": "string",
      "title": "Icon key"
    },
    "image_url": {
      "type": "string",
      "title": "Image"
    },
    "is_published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Order",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}