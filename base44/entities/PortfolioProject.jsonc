{
  "name": "PortfolioProject",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Project title"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "business_name": {
      "type": "string",
      "title": "Business name"
    },
    "industry": {
      "type": "string",
      "title": "Industry"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "thumbnail_url": {
      "type": "string",
      "title": "Thumbnail"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Screenshots"
    },
    "desktop_preview_url": {
      "type": "string",
      "title": "Desktop preview"
    },
    "mobile_preview_url": {
      "type": "string",
      "title": "Mobile preview"
    },
    "external_url": {
      "type": "string",
      "title": "Live website URL"
    },
    "tech": {
      "type": "string",
      "title": "Scope"
    },
    "timeline": {
      "type": "string",
      "title": "Timeline"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "is_concept": {
      "type": "boolean",
      "title": "Concept project",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Order",
      "default": 0
    }
  },
  "required": [
    "title",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}