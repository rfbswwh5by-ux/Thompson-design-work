{
  "name": "Faq",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "title": "Question"
    },
    "answer": {
      "type": "string",
      "title": "Answer"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "is_published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Order",
      "default": 0
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}