{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "title": "Customer name"
    },
    "business_name": {
      "type": "string",
      "title": "Business name"
    },
    "quote": {
      "type": "string",
      "title": "Testimonial"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo or logo"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5)"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "title": "Published",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Order",
      "default": 0
    }
  },
  "required": [
    "customer_name",
    "quote"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}